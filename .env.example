# Next.js backend only. Never put this key in the extension or a WXT_ variable.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.8-flash
# Origin of this Next.js backend, used by /api/send-notes to call /api/ai-query.
# Required in production; development defaults to http://localhost:3001.
APP_BASE_URL=http://localhost:3001
